{
  "name": "@antdv-next/cli",
  "type": "module",
  "version": "0.0.0-beta.4",
  "packageManager": "pnpm@11.9.0",
  "description": "CLI tool for querying antdv-next knowledge and analyzing antdv-next usage in projects",
  "license": "MIT",
  "homepage": "https://github.com/antdv-next/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antdv-next/cli.git"
  },
  "bugs": {
    "url": "https://github.com/antdv-next/cli/issues"
  },
  "keywords": [
    "antdv-next",
    "ant-design-vue",
    "antdv",
    "cli",
    "component",
    "vue"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "antdv": "./bin/antdv.js"
  },
  "files": [
    "data",
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "prepublishOnly": "pnpm build",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "generate-changelog": "tsx ./scripts/changelog.ts",
    "extract": "tsx ./scripts/sync.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "boxen": "^8.0.1",
    "citty": "^0.2.2",
    "console-table-printer": "^2.16.1",
    "envinfo": "^7.21.0",
    "fast-levenshtein": "^3.0.0",
    "glob": "^13.0.6",
    "local-pkg": "^1.2.1",
    "pkg-types": "^2.3.1",
    "semver": "^7.8.5",
    "tinyexec": "^1.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "dayjs": "^1.11.21",
    "eslint": "^10.8.1",
    "eslint-plugin-vuoto": "^0.1.2",
    "giget": "^3.3.1",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "picocolors": "^1.1.1",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "verify-git-commit": "^0.0.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx verify-git-commit"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
