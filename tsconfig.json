{
    "extends": "@lonewolfyx/tsconfig/tsconfig.lib.json",
    "compilerOptions": {
        "baseUrl": "./",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "#/*": [
                "./src/types/*"
            ]
        },
        "resolveJsonModule": true,
        "types": [
            "node",
            "tsdown/client"
        ],
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "declarationMap": false
    }
}
